# Live YouTube subscriber counts on the client roster (/api/channel-stats).
# Create a key in Google Cloud Console with the "YouTube Data API v3"
# enabled, then restrict it to that API.
#
# Optional: without it the roster still renders and simply falls back to the
# hand-entered figures in lib/clients.ts.
YOUTUBE_API_KEY=

# Scheduling link for the "Book a Strategy Call" calendar on /contact, which
# is the conversion path there (it replaced the enquiry form).
#
# Optional: lib/site falls back to https://calendly.com/admin-pushwebb/30min,
# so set this only to point the page at a different calendar.
NEXT_PUBLIC_CALENDLY_URL=

# Traffic tracking on the home page. Each tag is skipped when its ID is
# empty, so leave these blank in previews to keep test traffic out of the
# real property.
#
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook) pixel ID — the numeric ID from Events Manager.
NEXT_PUBLIC_FB_PIXEL_ID=

# Callback requests from the "Leave your number" card on /contact go out
# through EmailJS first (see lib/site, EMAILJS — the IDs are public by
# design and live in code). This is the SERVER-SIDE FALLBACK, used only
# when EmailJS fails or runs out of monthly quota.
#
# Optional but recommended. Create the key at resend.com/api-keys and
# verify pushwebb.com under Domains, so mail can be sent from the domain.
# Without it the form stays up but reports that callbacks aren't configured
# and points the visitor at WhatsApp and email instead.
RESEND_API_KEY=

# Optional: where callback requests land. Defaults to CONTACT_EMAIL in
# lib/site (admin@pushwebb.com).
CALLBACK_TO_EMAIL=

# Optional: the From address. Defaults to
# "PUSHWebb Website <noreply@pushwebb.com>", which requires the verified
# domain above. For a quick test before verifying, Resend accepts
# "onboarding@resend.dev" — it can only deliver to the account owner.
CALLBACK_FROM_EMAIL=

# Optional EmailJS overrides, for pointing a preview deploy at a test
# template. Left blank, the live IDs in lib/site are used.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
